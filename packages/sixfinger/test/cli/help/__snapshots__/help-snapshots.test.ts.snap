// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`sixfinger CLI help-text snapshots every documented command emits stable help text: sixfinger acp --help 1`] = `
"sixfinger acp

start ACP (Agent Client Protocol) server

Options:
  -h, --help         show help                                                             [boolean]
  -v, --version      show version number                                                   [boolean]
      --print-logs   print logs to stderr                                                  [boolean]
      --log-level    log level                  [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure         run without external plugins                                          [boolean]
      --port         port to listen on                                         [number] [default: 0]
      --hostname     hostname to listen on                           [string] [default: "127.0.0.1"]
      --mdns         enable mDNS service discovery (defaults hostname to 0.0.0.0)
                                                                          [boolean] [default: false]
      --mdns-domain  custom domain name for mDNS service (default: sixfinger.local)
                                                                [string] [default: "sixfinger.local"]
      --cors         additional domains to allow for CORS                      [array] [default: []]
      --cwd          working directory [string] [default: "<HOME>"]"
`;

exports[`sixfinger CLI help-text snapshots every documented command emits stable help text: sixfinger mcp --help 1`] = `
"sixfinger mcp

manage MCP (Model Context Protocol) servers

Commands:
  sixfinger mcp add [name]     add an MCP server
  sixfinger mcp list           list MCP servers and their status                        [aliases: ls]
  sixfinger mcp auth [name]    authenticate with an OAuth-enabled MCP server
  sixfinger mcp logout [name]  remove OAuth credentials for an MCP server
  sixfinger mcp debug <name>   debug OAuth connection for an MCP server

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                           [boolean]"
`;

exports[`sixfinger CLI help-text snapshots every documented command emits stable help text: sixfinger attach --help 1`] = `
"sixfinger attach <url>

attach to a running sixfinger server

Positionals:
  url  http://localhost:4096                                                     [string] [required]

Options:
  -h, --help          show help                                                            [boolean]
  -v, --version       show version number                                                  [boolean]
      --print-logs    print logs to stderr                                                 [boolean]
      --log-level     log level                 [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure          run without external plugins                                         [boolean]
      --dir           directory to run in                                                   [string]
  -c, --continue      continue the last session                                            [boolean]
  -s, --session       session id to continue                                                [string]
      --fork          fork the session when continuing (use with --continue or --session)  [boolean]
  -p, --password      basic auth password (defaults to SIXFINGER_SERVER_PASSWORD)            [string]
  -u, --username      basic auth username (defaults to SIXFINGER_SERVER_USERNAME or 'sixfinger')
                                                                                            [string]
      --mini          start the minimal interactive interface             [boolean] [default: false]
      --no-replay     disable mini session history replay on resume and after resize       [boolean]
      --replay-limit  cap visible mini replay to the newest N messages                      [number]"
`;

exports[`sixfinger CLI help-text snapshots every documented command emits stable help text: sixfinger run --help 1`] = `
"sixfinger run [message..]

run sixfinger with a message

Positionals:
  message  message to send                                                     [array] [default: []]

Options:
  -h, --help         show help                                                             [boolean]
  -v, --version      show version number                                                   [boolean]
      --print-logs   print logs to stderr                                                  [boolean]
      --log-level    log level                  [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure         run without external plugins                                          [boolean]
      --command      the command to run, use message for args                               [string]
  -c, --continue     continue the last session                                             [boolean]
  -s, --session      session id to continue                                                 [string]
      --fork         fork the session before continuing (requires --continue or --session) [boolean]
      --share        share the session                                                     [boolean]
  -m, --model        model to use in the format of provider/model                           [string]
      --agent        agent to use                                                           [string]
      --format       format: default (formatted) or json (raw JSON events)
                                          [string] [choices: "default", "json"] [default: "default"]
  -f, --file         file(s) to attach to message                                            [array]
      --title        title for the session (uses truncated prompt if no value provided)     [string]
      --attach       attach to a running sixfinger server (e.g., http://localhost:4096)      [string]
  -p, --password     basic auth password (defaults to SIXFINGER_SERVER_PASSWORD)             [string]
  -u, --username     basic auth username (defaults to SIXFINGER_SERVER_USERNAME or 'sixfinger')
                                                                                            [string]
      --dir          directory to run in, path on remote server if attaching                [string]
      --port         port for the local server (defaults to random port if no value provided)
                                                                                            [number]
      --variant      model variant (provider-specific reasoning effort, e.g., high, max, minimal)
                                                                                            [string]
      --thinking     show thinking blocks                                                  [boolean]
  -i, --interactive  run in direct interactive split-footer mode          [boolean] [default: false]
      --auto         auto-approve permissions that are not explicitly denied (dangerous!)
                                                                          [boolean] [default: false]"
`;

exports[`sixfinger CLI help-text snapshots every documented command emits stable help text: sixfinger debug --help 1`] = `
"sixfinger debug

debugging and troubleshooting tools

Commands:
  sixfinger debug config        show resolved configuration
  sixfinger debug lsp           LSP debugging utilities
  sixfinger debug rg            ripgrep debugging utilities
  sixfinger debug file          file system debugging utilities
  sixfinger debug scrap         list all known projects
  sixfinger debug skill         list all available skills
  sixfinger debug snapshot      snapshot debugging utilities
  sixfinger debug startup       print startup timing
  sixfinger debug agent <name>  show agent configuration details
  sixfinger debug v2            debug v2 catalog and built-in plugins
  sixfinger debug info          show debug information
  sixfinger debug paths         show global paths (data, config, cache, state)
  sixfinger debug wait          wait indefinitely (for debugging)

